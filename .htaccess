# Shared hosting: route /api/* to PHP endpoints.
# If the site lives in a subfolder, set RewriteBase, e.g. RewriteBase /wedding/

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteRule ^api/rsvp$ api/rsvp.php [L,QSA]
RewriteRule ^api/session$ api/session.php [L,QSA]
RewriteRule ^api/rsvps$ api/rsvps.php [L,QSA]
RewriteRule ^api/logout$ api/logout.php [L,QSA]

RewriteRule ^api/ - [F,L]
RewriteRule ^data/ - [F,L]
</IfModule>
