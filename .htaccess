# Shared hosting: route /api/* to PHP endpoints.
# If the site lives in a subfolder, set RewriteBase, e.g. RewriteBase /wedding/

<IfModule mod_rewrite.c>
RewriteEngine On

# Clean URLs and .php both map to the same scripts.
RewriteRule ^api/(rsvp|session|rsvps|logout)(\.php)?$ api/$1.php [L,QSA]

# Block anything else under /api/ (e.g. _common.php) and /data/
RewriteRule ^api/ - [F,L]
RewriteRule ^data/ - [F,L]
</IfModule>
